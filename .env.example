
# API CONFIGURATION
# URL where the API can be accessed by the browser
# This setting allows the frontend to connect to the API at runtime (no rebuild needed!)
#
# IMPORTANT: Do NOT include /api at the end - it will be added automatically!
#
# Common scenarios:
# - Docker on localhost: http://localhost:5055 (default, works for most cases)
# - Docker on LAN/remote server: http://192.168.1.100:5055 or http://your-server-ip:5055
# - Behind reverse proxy with custom domain: https://your-domain.com
# - Behind reverse proxy with subdomain: https://api.your-domain.com
#
# Examples for reverse proxy users:
# - API_URL=https://notebook.example.com  (frontend will call https://notebook.example.com/api/*)
# - API_URL=https://api.example.com       (frontend will call https://api.example.com/api/*)
#
# Note: If not set, the system will auto-detect based on the incoming request.
# Only set this if you need to override the auto-detection (e.g., reverse proxy scenarios).
API_URL=http://localhost:5055

# API CLIENT TIMEOUT (in seconds)
# Controls how long the frontend/Streamlit UI waits for API responses
# Increase this if you're using slow AI providers or hardware (Ollama on CPU, remote LM Studio, etc.)
# Default: 300 seconds (5 minutes) - sufficient for most transformation/insight operations
#
# Common scenarios:
# - Fast cloud APIs (OpenAI, Anthropic): 300 seconds is more than enough
# - Local Ollama on GPU: 300 seconds should work fine
# - Local Ollama on CPU: Consider 600 seconds (10 minutes) or more
# - Remote LM Studio over slow network: Consider 900 seconds (15 minutes)
# - Very large documents: May need 900+ seconds
#
# API_CLIENT_TIMEOUT=300

# MODELS
# Every model call goes through the model gate to llama-swap (ADR 0006); which
# model does what is in config/modelregister.yaml (ADR 0007). The fork reads no
# cloud API keys.

# TTS BATCH SIZE
# Controls concurrent TTS requests for podcast generation (default: 5)
# Lower values reduce provider load but increase generation time
# Recommended: OpenAI=5, ElevenLabs=2, Google=4, Custom=1
# TTS_BATCH_SIZE=2

# CONNECTION DETAILS FOR YOUR SURREAL DB
# New format (preferred) - WebSocket URL
SURREAL_URL="ws://surrealdb/rpc:8000"
SURREAL_USER="root"
SURREAL_PASSWORD="root"
SURREAL_NAMESPACE="open_notebook"
SURREAL_DATABASE="staging"

# FIRECRAWL - Get a key at https://firecrawl.dev/
FIRECRAWL_API_KEY=

# JINA - Get a key at https://jina.ai/
JINA_API_KEY=

# HUGGINGFACE - Required for speaker diarization (pyannote models)
# Get a token at https://huggingface.co/settings/tokens
# You also need to accept the pyannote model license agreements
# HF_TOKEN=

# VAULT INTEGRATION (Obsidian or other)
# Path to your vault directory. Entity notes are read from VAULT_ENTITIES_FOLDER.
# Each .md file = one entity, with aliases in YAML frontmatter.
# VAULT_PATH=/home/user/Obsidian/MyVault
# VAULT_ENTITIES_FOLDER=Entities
# VAULT_SYNC_ON_STARTUP=false

# PIPELINE CONFIGURATION
# Override default model/URL for the ontology extraction pipeline
# LANGEXTRACT_MODEL_ID=qwen2.5:latest
# LANGEXTRACT_MODEL_URL=http://localhost:11434

# Override default model/URL for the summarization pipeline
# SUMMARIZATION_MODEL=qwen2.5:14b
# SUMMARIZATION_PROVIDER=ollama
# SUMMARIZATION_BASE_URL=http://localhost:11434

# SIGNAALSYSTEEM (docker-compose.signaalsysteem.yml, F2-10)
# Hostpaden; alleen-lezen gekoppeld aan open-notebook (en later langflow) op
# /inname en /watchfolder. Voorbeelden; zet hier de echte mappen.
# SIGNAAL_INNAMEMAP=D:/Data/signaal/inname
# SIGNAAL_WATCHFOLDER=D:/Data/signaal/watchfolder
# Alleen voor de startcontrole (scripts/signaalsysteem/controle/padlijsten.py):
# de vault en de exportmap op de host. De fork koppelt de vault nooit.
# SIGNAAL_VAULT=D:/pad/naar/vault
# SIGNAAL_EXPORTMAP=D:/pad/naar/exportmap
# Poort van de werkbak op 127.0.0.1 (standaard 8520).
# SIGNAAL_WERKBAK_POORT=8520
# Poort van de editor van Langflow (editor-toegang) op 127.0.0.1 (standaard 8530).
# SIGNAAL_EDITOR_POORT=8530
# Database in SurrealDB (namespace signaal; standaard database signaal).
# SIGNAAL_SURREAL_DATABASE=signaal
# Optioneel: verwachte Git-commit van de flows (F2-04).
# SIGNAAL_FLOWS_COMMIT=
# Hosts die als URL-locatie mogen, ook als ze lokaal zijn (gescheiden door ;).
# SIGNAAL_INNAME_URLS=
# Geheimen staan niet hier maar als bestand in secrets/ (buiten Git):
# secrets/surreal_gebruiker en secrets/surreal_wachtwoord.
